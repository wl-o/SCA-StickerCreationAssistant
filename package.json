{
  "name": "ai-sticker-creator",
  "private": true,
  "version": "0.1.0",
  "description": "AI贴图创作助手桌面版",
  "author": "genTT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "server": "tsx server/src/index.ts",
    "build": "vue-tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "electron:dev": "concurrently -k -n web,electron -c green,magenta \"npm:dev:web\" \"npm:electron:open\"",
    "electron:open": "wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "electron:build": "npm run build && npm run build:server && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "8.2.0",
    "better-sqlite3": "^13.0.3",
    "element-plus": "^2.14.5",
    "fastify": "^5.12.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "cross-env": "7.0.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.gentt.aisticker",
    "productName": "AI贴图创作助手",
    "copyright": "Copyright © genTT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
